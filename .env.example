# =============================================================================
#  BOT DE SCALPING - CONFIGURATION
#  Copier ce fichier en .env puis remplir. Ne JAMAIS commiter le .env.
# =============================================================================

# --- SECURITE : commencer TOUJOURS en simulation -----------------------------
# true  = aucun ordre reel, le bot simule avec DRY_RUN_EQUITY
# false = ordres reels avec de l'argent reel
DRY_RUN=true
DRY_RUN_EQUITY=1000
BINANCE_TESTNET=false

# --- Cles Binance (inutiles tant que DRY_RUN=true) ---------------------------
# Permission requise : "Enable Spot & Margin Trading"
# Ne PAS activer les retraits. Restreindre a l'IP de votre serveur.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# --- Notifications Telegram (optionnel) --------------------------------------
# TELEGRAM_CHAT_ID s'obtient via @userinfobot
BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Marche ------------------------------------------------------------------
QUOTE_ASSET=USDT
MIN_QUOTE_VOLUME=20000000
MAX_SPREAD_PCT=0.06
MAX_UNIVERSE=40
# Pour ne trader que certaines paires : SYMBOL_WHITELIST=BTCUSDT,ETHUSDT,SOLUSDT
SYMBOL_WHITELIST=
SYMBOL_BLACKLIST=

# --- Strategie ---------------------------------------------------------------
ENTRY_TIMEFRAME=1m
TREND_TIMEFRAME=5m
# Score minimum sur 6 pour entrer. 3 = tres agressif, 5 = tres selectif.
MIN_ENTRY_SCORE=4
REQUIRE_TREND_FILTER=true
MIN_ATR_PCT=0.08
MAX_ATR_PCT=2.50

# --- Stop loss / take profit -------------------------------------------------
SL_ATR_MULT=1.1
TP_ATR_MULT=1.8
MIN_SL_PCT=0.25
MAX_SL_PCT=1.50
BREAKEVEN_AT_R=0.6
TRAIL_ACTIVATE_R=1.0
TRAIL_ATR_MULT=0.9
MAX_HOLD_SECONDS=900

# --- Money management --------------------------------------------------------
# Risque par trade en % du capital. La taille du lot en decoule automatiquement.
BASE_RISK_PCT=0.75
MIN_RISK_PCT=0.20
MAX_RISK_PCT=2.00
# Progressif : le lot augmente apres des gains consecutifs.
WIN_STREAK_STEP=1.15
MAX_STREAK_MULT=1.80
# Regressif : le lot diminue apres des pertes consecutives (jamais de martingale).
LOSS_STREAK_STEP=0.70
MIN_STREAK_MULT=0.35
# Le risque en % baisse quand le capital grossit (0 = risque constant).
EQUITY_REF=500
EQUITY_DECAY=0.15
MAX_POSITION_PCT=25
MAX_TOTAL_EXPOSURE_PCT=80

# --- Garde-fous --------------------------------------------------------------
MAX_OPEN_POSITIONS=4
MAX_TRADES_PER_DAY=0
DAILY_MAX_LOSS_PCT=6.0
DAILY_SOFT_LOSS_PCT=3.0
DAILY_PROFIT_TARGET_PCT=0
MAX_CONSECUTIVE_LOSSES=6
SYMBOL_COOLDOWN_SECONDS=180

# --- Cadence -----------------------------------------------------------------
SCAN_INTERVAL_SECONDS=20
MONITOR_INTERVAL_SECONDS=2
HEARTBEAT_SECONDS=300

# --- Frais Binance -----------------------------------------------------------
FEE_RATE=0.001
FEE_SAFETY_MULT=1.8

# --- Ancien bot d'analyse main.py (optionnel) --------------------------------
TWELVE_API_KEY=
