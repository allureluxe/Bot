# ============================================================
# CONFIGURATION DU BOT TRADING TELEGRAM
# ============================================================
# Copiez ce fichier et renommez-le en .env :
#   cp .env.example .env
# Puis remplissez vos vraies clés ci-dessous.
# Ne partagez JAMAIS le fichier .env — il contient vos secrets.
# ============================================================

# 1. TOKEN DU BOT TELEGRAM
#    Obtenez-le gratuitement sur https://t.me/BotFather :
#      /newbot → suivez les instructions → copiez le token
BOT_TOKEN=your_telegram_bot_token_here

# 2. CLÉ API TWELVE DATA
#    Créez un compte gratuit sur https://twelvedata.com/
#    → Dashboard → API Keys → copiez votre clé
TWELVE_API_KEY=your_twelve_data_api_key_here
